# PostgreSQL connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gamedeals?schema=public"

# App configuration
APP_URL="https://game.alperates.com.tr"
APP_TIMEZONE="Europe/Istanbul"

# Microsoft / Xbox catalog parameters
XBOX_MARKET="TR"
XBOX_LANGUAGE="tr-TR"

# Rate limiting and collector defaults
XBOX_BATCH_SIZE=25
XBOX_MAX_CONCURRENCY=2
XBOX_REQUEST_DELAY_MIN_MS=750
XBOX_REQUEST_DELAY_MAX_MS=1500
XBOX_REQUEST_TIMEOUT_MS=15000
XBOX_MAX_RETRIES=4
