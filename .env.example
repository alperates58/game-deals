# ==============================================================================
# GAME-DEALS ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# [MANDATORY FOR PRODUCTION & DOCKER]
# Strong password for PostgreSQL database
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

# [MANDATORY FOR PRODUCTION & DOCKER]
# High-entropy JWT session encryption secret (minimum 64 characters)
# Generate with: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_MINIMUM_64_CHARACTERS_LONG_HIGH_ENTROPY_PRODUCTION_SESSION_SECRET

# Database connection URL (for local dev / direct connection)
DATABASE_URL="postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/gamedeals?schema=public"

# Database defaults
POSTGRES_USER=postgres
POSTGRES_DB=gamedeals

# App configuration
APP_URL="https://game.alperates.com.tr"
APP_TIMEZONE="Europe/Istanbul"
ALLOW_REGISTRATION=true

# Microsoft / Xbox catalog parameters
XBOX_MARKET="TR"
XBOX_LANGUAGE="tr-TR"

# Rate limiting and collector defaults
XBOX_BATCH_SIZE=25
XBOX_MAX_CONCURRENCY=2
XBOX_REQUEST_DELAY_MIN_MS=750
XBOX_REQUEST_DELAY_MAX_MS=1500
XBOX_REQUEST_TIMEOUT_MS=15000
XBOX_MAX_RETRIES=4
