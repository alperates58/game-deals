datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SyncType {
  PRICE_SYNC
  CORE_SYNC
  DISCOVERY
  RECLASSIFICATION
  METADATA_REFRESH
  RELATIONSHIP_REFRESH
}

enum DiscoverySource {
  FULL_CATALOG
  RELATED
  MANUAL
}

enum SyncStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum DealVerdict {
  EXCELLENT   // 🔥 Kaçırma (90-100)
  VERY_GOOD   // 🟢 Çok İyi (80-89)
  GOOD        // 🟡 İyi (65-79)
  WAIT        // 🟠 Bekle (45-64)
  POOR        // 🔴 Zayıf Fırsat (0-44)
}

enum ProductClass {
  BASE_GAME
  BUNDLE
  DLC
  ADD_ON
  EXPANSION
  SEASON_PASS
  CONTENT_PACK
  CURRENCY
  CONSUMABLE
  UNKNOWN
}

enum RelationType {
  BUNDLE_CONTAINS
  DLC_OF
  EXPANSION_OF
  ADDON_OF
  SEASON_PASS_OF
}

model Game {
  id                String          @id @default(cuid())
  xboxProductId     String          @unique
  slug              String          @unique
  title             String
  normalizedTitle   String
  publisher         String?
  developer         String?
  franchise         String?
  edition           String?
  productType       String          @default("Game")
  productClass      ProductClass    @default(UNKNOWN)
  releaseDate       DateTime?
  imageUrl          String?
  storeUrl          String
  isCore            Boolean         @default(false)
  isActive          Boolean         @default(true)
  isFree            Boolean         @default(false)
  popularityScore   Float           @default(0)
  discoverySource   DiscoverySource @default(FULL_CATALOG)
  platforms         String[]        @default([])
  isSeriesXCompatible Boolean       @default(true)

  // Enriched metadata fields
  shortDescription  String?
  longDescription   String?
  genres            String[]        @default([])
  capabilities      String[]        @default([])
  screenshots       String[]        @default([])

  // Current pricing snapshot
  currentPrice      Decimal         @db.Decimal(10, 2)
  listPrice         Decimal         @db.Decimal(10, 2)
  discountPercent   Int             @default(0)
  currency          String          @default("TRY")

  // Observed historical low
  historicalLow     Decimal         @db.Decimal(10, 2)
  historicalLowAt   DateTime        @default(now())

  firstSeenAt       DateTime        @default(now())
  lastSeenAt        DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  priceHistories    PriceHistory[]
  dealAnalysis      DealAnalysis?

  // Relationships (Bundle contains children, Base game has DLCs)
  childRelations    GameRelation[]  @relation("ParentGame")
  parentRelations   GameRelation[]  @relation("ChildGame")

  // Personal Game Hub relations
  userGames          UserGame[]
  priceAlerts        PriceAlert[]
  notificationEvents NotificationEvent[]

  // Admin and Extended foundations
  manualOverride     GameManualOverride?
  ratings            ExternalRating[]
  subscriptions      GameSubscription[]
  languageSupports   GameLanguageSupport[]
  mediaItems         GameMedia[]

  @@index([isCore, isActive])
  @@index([productClass, isActive])
  @@index([isSeriesXCompatible, isActive])
  @@index([discoverySource])
  @@index([discountPercent(sort: Desc)])
  @@index([historicalLow])
}

model GameRelation {
  id           String       @id @default(cuid())
  parentGameId String
  parentGame   Game         @relation("ParentGame", fields: [parentGameId], references: [id], onDelete: Cascade)
  childGameId  String
  childGame    Game         @relation("ChildGame", fields: [childGameId], references: [id], onDelete: Cascade)
  relationType RelationType @default(BUNDLE_CONTAINS)
  position     Int          @default(0)
  source       String       @default("MICROSOFT_DISPLAY_CATALOG")
  observedAt   DateTime     @default(now())

  @@unique([parentGameId, childGameId, relationType])
  @@index([parentGameId])
  @@index([childGameId])
}

model PriceHistory {
  id              String       @id @default(cuid())
  gameId          String
  game            Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  observedAt      DateTime     @default(now())
  listPrice       Decimal      @db.Decimal(10, 2)
  currentPrice    Decimal      @db.Decimal(10, 2)
  discountPercent Int          @default(0)
  currency        String       @default("TRY")
  isOnSale        Boolean      @default(false)
  saleEndAt       DateTime?

  @@index([gameId, observedAt(sort: Desc)])
  @@index([gameId, currentPrice(sort: Asc)])
}

model DealAnalysis {
  gameId                String          @id
  game                  Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  dealScore             Int             // 0-100
  confidenceScore       ConfidenceLevel @default(LOW)
  historicalPosition    Float           // 0.0 - 1.0 (0: at low, 1: at high)
  saleFrequency         Float           @default(0)
  daysSinceBetterPrice  Int?
  verdict               DealVerdict     @default(WAIT)
  reason                String          // Türkçe gerekçe
  calculatedAt          DateTime        @default(now())
}

model SyncRun {
  id              String       @id @default(cuid())
  type            SyncType
  status          SyncStatus   @default(RUNNING)
  startedAt       DateTime     @default(now())
  finishedAt      DateTime?
  productsFound   Int          @default(0)
  productsChecked Int          @default(0)
  productsAdded   Int          @default(0)
  pricesChanged   Int          @default(0)
  errorCount      Int          @default(0)
  errorSummary    String?
}

enum Role {
  OWNER
  USER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipTier {
  FREE
  PRO
}

enum AuthProvider {
  GOOGLE
}

model User {
  id                     String                      @id @default(cuid())
  email                  String                      @unique
  name                   String
  passwordHash           String?
  role                   Role                        @default(USER)
  accountStatus          AccountStatus               @default(ACTIVE)
  membershipTier         MembershipTier              @default(FREE)
  emailVerifiedAt        DateTime?
  avatarUrl              String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  lastLoginAt            DateTime?

  accounts               AuthAccount[]
  userGames              UserGame[]
  priceAlerts            PriceAlert[]
  notificationEvents     NotificationEvent[]
  notificationPreferences UserNotificationPreference[]
  notificationSettings   UserNotificationSettings?
  telegramConnection     TelegramConnection?
  telegramLinkTokens     TelegramLinkToken[]
  emailVerificationTokens EmailVerificationToken[]
  userNotifications      UserNotification[]
  notificationDeliveries NotificationDelivery[]
  adminAuditLogsCreated  AdminAuditLog[]             @relation("ActorUser")
  adminAuditLogsTargeted AdminAuditLog[]             @relation("TargetUser")
  gameManualOverrides    GameManualOverride[]

  @@index([role, accountStatus])
}

model AuthAccount {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          AuthProvider
  providerAccountId String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model UserGame {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  owned     Boolean  @default(false)
  favorite  Boolean  @default(false)
  wishlist  Boolean  @default(false)

  liked     Boolean  @default(false)
  disliked  Boolean  @default(false)

  completed Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, gameId])
  @@index([userId, owned])
  @@index([userId, favorite])
  @@index([userId, wishlist])
}

enum PriceAlertType {
  ANY_DISCOUNT
  PRICE_BELOW
  DISCOUNT_AT_LEAST
  OBSERVED_LOW
  DEAL_SCORE_AT_LEAST
}

model PriceAlert {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId           String
  game             Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)

  type             PriceAlertType @default(ANY_DISCOUNT)
  targetPrice      Decimal?       @db.Decimal(10, 2)
  targetDiscount   Int?
  targetDealScore  Int?

  isEnabled        Boolean        @default(true)
  lastTriggeredAt  DateTime?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([gameId, isEnabled])
  @@index([userId])
}

enum NotificationEventType {
  PRICE_DROP
  ALERT_MATCHED
  NEW_OBSERVED_LOW
  DEAL_SCORE_THRESHOLD
  OWNED_GAME_DLC_DEAL
  WISHLIST_DEAL
  FAVORITE_PRICE_CHANGE
}

enum NotificationStatus {
  PENDING
  PROCESSED
  FAILED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  TELEGRAM
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  RETRYING
  FAILED
}

model NotificationEvent {
  id          String                @id @default(cuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId      String?
  game        Game?                 @relation(fields: [gameId], references: [id], onDelete: Cascade)

  type        NotificationEventType
  payload     Json
  status      NotificationStatus    @default(PENDING)
  dedupeKey   String?               @unique
  readAt      DateTime?

  createdAt   DateTime              @default(now())
  processedAt DateTime?

  deliveries  NotificationDelivery[]

  @@index([userId, status])
  @@index([createdAt])
  @@index([type])
}

model NotificationDelivery {
  id                String                     @id @default(cuid())
  eventId           String
  event             NotificationEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId            String
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel           NotificationChannel
  status            NotificationDeliveryStatus @default(PENDING)

  attemptCount      Int                        @default(0)
  maxAttempts       Int                        @default(5)
  nextAttemptAt     DateTime                   @default(now())
  lastAttemptAt     DateTime?
  sentAt            DateTime?

  providerMessageId String?
  lastErrorSummary  String?

  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@unique([eventId, channel])
  @@index([status, nextAttemptAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([channel, status])
}

model UserNotificationPreference {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType NotificationEventType
  channel   NotificationChannel
  enabled   Boolean               @default(true)

  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([userId, eventType, channel])
  @@index([userId])
}

model UserNotificationSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  quietHoursEnabled Boolean  @default(false)
  quietHoursStart   String?  // HH:MM e.g. "23:00"
  quietHoursEnd     String?  // HH:MM e.g. "08:00"
  timezone          String   @default("Europe/Istanbul")

  defaultAlertType  PriceAlertType @default(ANY_DISCOUNT)
  defaultLanguage   String   @default("tr-TR")
  defaultCurrency   String   @default("TRY")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model UserNotification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String?
  title     String
  message   String
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
}

model TelegramConnection {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramChatId String    @unique
  telegramUsername String?
  displayName    String?
  linkedAt       DateTime  @default(now())
  lastVerifiedAt DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([telegramChatId])
}

model TelegramLinkToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model SystemSetting {
  id                               String    @id @default("global")
  siteName                         String    @default("Game Deals")
  maintenanceMode                  Boolean   @default(false)
  allowRegistration                Boolean   @default(true)

  // Feature flags
  showDeals                        Boolean   @default(true)
  showHistoricalLow                Boolean   @default(true)
  showDlc                          Boolean   @default(true)
  showRatings                      Boolean   @default(true)
  showSubscriptions                Boolean   @default(true)

  // Global Notification master switches
  inAppNotificationsEnabled        Boolean   @default(true)
  emailNotificationsEnabled        Boolean   @default(false)
  telegramNotificationsEnabled     Boolean   @default(false)

  // SEO Defaults
  defaultTitle                     String    @default("Game Deals | Türkiye Xbox Oyun İndirimleri ve Fırsat Takibi")
  defaultDescription               String    @default("Xbox Series X|S oyun indirimleri, tarihi dip fiyatlar, DLC fırsatları ve yapay zeka destekli fiyat analizi.")
  robotsIndex                      Boolean   @default(true)

  // Xbox Series X|S Scheduler & Discovery Settings
  autoDiscoverSeriesCatalog        Boolean   @default(true)
  catalogDiscoveryIntervalHours    Int       @default(24) // 24h
  priceSyncIntervalHours           Int       @default(6)  // 6h
  metadataRefreshIntervalHours     Int       @default(168) // 168h (7 days)
  relationshipRefreshIntervalHours Int       @default(168) // 168h (7 days)

  // Tracking timestamps
  lastCatalogDiscoveryAt           DateTime?
  lastPriceSyncAt                  DateTime?
  lastMetadataRefreshAt            DateTime?
  lastRelationshipRefreshAt        DateTime?

  // Legacy compatibility
  syncIntervalHours                Int       @default(6)

  autoDiscoverBundleChildren       Boolean   @default(true)
  autoDiscoverRelatedDlc           Boolean   @default(true)
  autoAddRelatedProducts           Boolean   @default(true)

  trackBaseGames                   Boolean   @default(true)
  trackBundles                     Boolean   @default(true)
  trackDlc                         Boolean   @default(true)
  trackExpansions                  Boolean   @default(true)
  trackSeasonPasses                Boolean   @default(true)
  trackAddons                      Boolean   @default(true)
  trackContentPacks                Boolean   @default(false)

  lastSyncStartedAt                DateTime?
  lastSyncFinishedAt               DateTime?
  lastSyncStatus                   String?

  updatedAt                        DateTime  @updatedAt
}

model DatabaseBackup {
  id                String       @id @default(cuid())
  filename          String       @unique
  mode              BackupMode   @default(FULL)
  status            BackupStatus @default(IN_PROGRESS)
  sizeBytes         BigInt       @default(0)
  tablesIncluded    String[]     @default([])
  rowCountEstimate  Int          @default(0)
  initiatedByUserId String?
  errorSummary      String?
  startedAt         DateTime     @default(now())
  completedAt       DateTime?

  @@index([startedAt(sort: Desc)])
}

enum BackupMode {
  FULL
  CATALOG
}

enum BackupStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  RESTORING
}

enum ScheduledJobType {
  CATALOG_DISCOVERY
  PRICE_SYNC
  METADATA_REFRESH
  RELATIONSHIP_REFRESH
}

enum ScheduledJobStatus {
  IDLE
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

model ScheduledJobState {
  id                 String             @id @default(cuid())
  jobType            ScheduledJobType   @unique
  enabled            Boolean            @default(true)
  lastStartedAt      DateTime?
  lastFinishedAt     DateTime?
  lastSuccessAt      DateTime?
  nextRunAt          DateTime?
  lastStatus         ScheduledJobStatus @default(IDLE)
  lastErrorSummary   String?
  lastDurationMs     Int?
  lastItemsProcessed Int                @default(0)
  lastItemsAdded     Int                @default(0)
  lastItemsChanged   Int                @default(0)
  lastErrorCount     Int                @default(0)
  last429Count       Int                @default(0)
  last5xxCount       Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([jobType])
  @@index([nextRunAt])
}

// ============================================================
// ADMIN AUDIT LOG & SAFE OVERRIDES & EXTENDED FOUNDATIONS
// ============================================================

model AdminAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actorUser    User?    @relation("ActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  action       String   // ROLE_CHANGE, SUSPEND_USER, REACTIVATE_USER, RESTORE_BACKUP, MANUAL_OVERRIDE, etc.
  entityType   String   // User, Game, SystemSetting, DatabaseBackup, etc.
  entityId     String?
  targetUserId String?
  targetUser   User?    @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  beforeJson   Json?
  afterJson    Json?
  reason       String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([action, createdAt(sort: Desc)])
}

model GameManualOverride {
  id              String        @id @default(cuid())
  gameId          String        @unique
  game            Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  title           String?
  publisher       String?
  developer       String?
  franchise       String?
  releaseDate     DateTime?
  productClass    ProductClass?
  imageUrl        String?
  isActive        Boolean?

  updatedByUserId String?
  updatedByUser   User?         @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)
  reason          String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([gameId])
}

enum RatingProvider {
  METACRITIC
  OPENCRITIC
}

model ExternalRating {
  id          String         @id @default(cuid())
  gameId      String
  game        Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  provider    RatingProvider
  criticScore Float?
  userScore   Float?
  reviewCount Int?
  url         String?
  source      String         @default("MANUAL") // MANUAL | SCRAPER
  observedAt  DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([gameId, provider])
  @@index([gameId])
}

enum SubscriptionService {
  GAME_PASS
  PS_PLUS
  EA_PLAY
  UBISOFT_PLUS
}

model GameSubscription {
  id         String              @id @default(cuid())
  gameId     String
  game       Game                @relation(fields: [gameId], references: [id], onDelete: Cascade)
  service    SubscriptionService
  tier       String?             // Core, Ultimate, Standard
  startedAt  DateTime?
  endedAt    DateTime?
  isActive   Boolean             @default(true)
  source     String              @default("MICROSOFT_STORE")
  observedAt DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([gameId, service])
  @@index([service, isActive])
  @@index([gameId])
}

model GameLanguageSupport {
  id                 String   @id @default(cuid())
  gameId             String
  game               Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  languageCode       String   // TR, EN, DE, FR, etc.
  interfaceSupported Boolean  @default(false)
  subtitlesSupported Boolean  @default(false)
  audioSupported     Boolean  @default(false)
  source             String   @default("MANUAL")
  observedAt         DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([gameId, languageCode])
  @@index([gameId])
  @@index([languageCode])
}

enum MediaType {
  TRAILER
  GAMEPLAY
  REVIEW
}

model GameMedia {
  id        String    @id @default(cuid())
  gameId    String
  game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  type      MediaType @default(TRAILER)
  title     String
  url       String
  provider  String    @default("YOUTUBE")
  source    String    @default("MANUAL")
  position  Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([gameId, isActive])
}
