datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SyncType {
  PRICE_SYNC
  CORE_SYNC
  DISCOVERY
  RECLASSIFICATION
  METADATA_REFRESH
  RELATIONSHIP_REFRESH
}

enum DiscoverySource {
  FULL_CATALOG
  RELATED
  MANUAL
}

enum SyncStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum DealVerdict {
  EXCELLENT   // 🔥 Kaçırma (90-100)
  VERY_GOOD   // 🟢 Çok İyi (80-89)
  GOOD        // 🟡 İyi (65-79)
  WAIT        // 🟠 Bekle (45-64)
  POOR        // 🔴 Zayıf Fırsat (0-44)
}

enum ProductClass {
  BASE_GAME
  BUNDLE
  DLC
  ADD_ON
  EXPANSION
  SEASON_PASS
  CONTENT_PACK
  CURRENCY
  CONSUMABLE
  UNKNOWN
}

enum RelationType {
  BUNDLE_CONTAINS
  DLC_OF
  EXPANSION_OF
  ADDON_OF
  SEASON_PASS_OF
}

model Game {
  id                String          @id @default(cuid())
  xboxProductId     String          @unique
  slug              String          @unique
  title             String
  normalizedTitle   String
  publisher         String?
  developer         String?
  franchise         String?
  edition           String?
  productType       String          @default("Game")
  productClass      ProductClass    @default(UNKNOWN)
  releaseDate       DateTime?
  imageUrl          String?
  storeUrl          String
  isCore            Boolean         @default(false)
  isActive          Boolean         @default(true)
  isFree            Boolean         @default(false)
  popularityScore   Float           @default(0)
  discoverySource   DiscoverySource @default(FULL_CATALOG)
  platforms         String[]        @default([])
  isSeriesXCompatible Boolean       @default(true)

  // Enriched metadata fields
  shortDescription  String?
  longDescription   String?
  genres            String[]        @default([])
  capabilities      String[]        @default([])
  screenshots       String[]        @default([])

  // Current pricing snapshot
  currentPrice      Decimal         @db.Decimal(10, 2)
  listPrice         Decimal         @db.Decimal(10, 2)
  discountPercent   Int             @default(0)
  currency          String          @default("TRY")

  // Observed historical low
  historicalLow     Decimal         @db.Decimal(10, 2)
  historicalLowAt   DateTime        @default(now())

  firstSeenAt       DateTime        @default(now())
  lastSeenAt        DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  priceHistories    PriceHistory[]
  dealAnalysis      DealAnalysis?

  // Relationships (Bundle contains children, Base game has DLCs)
  childRelations    GameRelation[]  @relation("ParentGame")
  parentRelations   GameRelation[]  @relation("ChildGame")

  // Personal Game Hub relations
  userGames          UserGame[]
  priceAlerts        PriceAlert[]
  notificationEvents NotificationEvent[]

  @@index([isCore, isActive])
  @@index([productClass, isActive])
  @@index([isSeriesXCompatible, isActive])
  @@index([discoverySource])
  @@index([discountPercent(sort: Desc)])
  @@index([historicalLow])
}

model GameRelation {
  id           String       @id @default(cuid())
  parentGameId String
  parentGame   Game         @relation("ParentGame", fields: [parentGameId], references: [id], onDelete: Cascade)
  childGameId  String
  childGame    Game         @relation("ChildGame", fields: [childGameId], references: [id], onDelete: Cascade)
  relationType RelationType @default(BUNDLE_CONTAINS)
  position     Int          @default(0)
  source       String       @default("MICROSOFT_DISPLAY_CATALOG")
  observedAt   DateTime     @default(now())

  @@unique([parentGameId, childGameId, relationType])
  @@index([parentGameId])
  @@index([childGameId])
}

model PriceHistory {
  id              String       @id @default(cuid())
  gameId          String
  game            Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  observedAt      DateTime     @default(now())
  listPrice       Decimal      @db.Decimal(10, 2)
  currentPrice    Decimal      @db.Decimal(10, 2)
  discountPercent Int          @default(0)
  currency        String       @default("TRY")
  isOnSale        Boolean      @default(false)
  saleEndAt       DateTime?

  @@index([gameId, observedAt(sort: Desc)])
  @@index([gameId, currentPrice(sort: Asc)])
}

model DealAnalysis {
  gameId                String          @id
  game                  Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  dealScore             Int             // 0-100
  confidenceScore       ConfidenceLevel @default(LOW)
  historicalPosition    Float           // 0.0 - 1.0 (0: at low, 1: at high)
  saleFrequency         Float           @default(0)
  daysSinceBetterPrice  Int?
  verdict               DealVerdict     @default(WAIT)
  reason                String          // Türkçe gerekçe
  calculatedAt          DateTime        @default(now())
}

model SyncRun {
  id              String       @id @default(cuid())
  type            SyncType
  status          SyncStatus   @default(RUNNING)
  startedAt       DateTime     @default(now())
  finishedAt      DateTime?
  productsFound   Int          @default(0)
  productsChecked Int          @default(0)
  productsAdded   Int          @default(0)
  pricesChanged   Int          @default(0)
  errorCount      Int          @default(0)
  errorSummary    String?
}

enum Role {
  OWNER
  USER
}

enum AuthProvider {
  GOOGLE
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String
  passwordHash       String?
  role               Role                @default(USER)
  avatarUrl          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lastLoginAt        DateTime?

  accounts           AuthAccount[]
  userGames          UserGame[]
  priceAlerts        PriceAlert[]
  notificationEvents NotificationEvent[]
}

model AuthAccount {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          AuthProvider
  providerAccountId String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model UserGame {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  owned     Boolean  @default(false)
  favorite  Boolean  @default(false)
  wishlist  Boolean  @default(false)

  liked     Boolean  @default(false)
  disliked  Boolean  @default(false)

  completed Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, gameId])
  @@index([userId, owned])
  @@index([userId, favorite])
  @@index([userId, wishlist])
}

enum PriceAlertType {
  ANY_DISCOUNT
  PRICE_BELOW
  DISCOUNT_AT_LEAST
  OBSERVED_LOW
  DEAL_SCORE_AT_LEAST
}

model PriceAlert {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId           String
  game             Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)

  type             PriceAlertType @default(ANY_DISCOUNT)
  targetPrice      Decimal?       @db.Decimal(10, 2)
  targetDiscount   Int?
  targetDealScore  Int?

  isEnabled        Boolean        @default(true)
  lastTriggeredAt  DateTime?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([gameId, isEnabled])
  @@index([userId])
}

enum NotificationEventType {
  PRICE_DROP
  ALERT_MATCHED
  NEW_OBSERVED_LOW
  DEAL_SCORE_THRESHOLD
  OWNED_GAME_DLC_DEAL
}

enum NotificationStatus {
  PENDING
  PROCESSED
  FAILED
}

model NotificationEvent {
  id          String                @id @default(cuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId      String?
  game        Game?                 @relation(fields: [gameId], references: [id], onDelete: Cascade)

  type        NotificationEventType
  payload     Json
  status      NotificationStatus    @default(PENDING)

  createdAt   DateTime              @default(now())
  processedAt DateTime?

  @@index([userId, status])
  @@index([createdAt])
}

model SystemSetting {
  id                               String    @id @default("global")
  allowRegistration                Boolean   @default(true)

  // Xbox Series X|S Scheduler & Discovery Settings
  autoDiscoverSeriesCatalog        Boolean   @default(true)
  catalogDiscoveryIntervalHours    Int       @default(24) // 24h
  priceSyncIntervalHours           Int       @default(6)  // 6h
  metadataRefreshIntervalHours     Int       @default(168) // 168h (7 days)
  relationshipRefreshIntervalHours Int       @default(168) // 168h (7 days)

  // Tracking timestamps
  lastCatalogDiscoveryAt           DateTime?
  lastPriceSyncAt                  DateTime?
  lastMetadataRefreshAt            DateTime?
  lastRelationshipRefreshAt        DateTime?

  // Legacy compatibility
  syncIntervalHours                Int       @default(6)

  autoDiscoverBundleChildren       Boolean   @default(true)
  autoDiscoverRelatedDlc           Boolean   @default(true)
  autoAddRelatedProducts           Boolean   @default(true)

  trackBaseGames                   Boolean   @default(true)
  trackBundles                     Boolean   @default(true)
  trackDlc                         Boolean   @default(true)
  trackExpansions                  Boolean   @default(true)
  trackSeasonPasses                Boolean   @default(true)
  trackAddons                      Boolean   @default(true)
  trackContentPacks                Boolean   @default(false)

  lastSyncStartedAt                DateTime?
  lastSyncFinishedAt               DateTime?
  lastSyncStatus                   String?

  updatedAt                        DateTime  @updatedAt
}

enum BackupMode {
  FULL
  CATALOG
}

enum BackupStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  RESTORING
}

model DatabaseBackup {
  id                String       @id @default(cuid())
  filename          String       @unique
  mode              BackupMode   @default(FULL)
  status            BackupStatus @default(IN_PROGRESS)
  sizeBytes         BigInt       @default(0)
  tablesIncluded    String[]     @default([])
  rowCountEstimate  Int          @default(0)
  initiatedByUserId String?
  errorSummary      String?
  startedAt         DateTime     @default(now())
  completedAt       DateTime?

  @@index([startedAt(sort: Desc)])
}

enum ScheduledJobType {
  CATALOG_DISCOVERY
  PRICE_SYNC
  METADATA_REFRESH
  RELATIONSHIP_REFRESH
}

enum ScheduledJobStatus {
  IDLE
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

model ScheduledJobState {
  id                 String             @id @default(cuid())
  jobType            ScheduledJobType   @unique
  enabled            Boolean            @default(true)
  lastStartedAt      DateTime?
  lastFinishedAt     DateTime?
  lastSuccessAt      DateTime?
  nextRunAt          DateTime?
  lastStatus         ScheduledJobStatus @default(IDLE)
  lastErrorSummary   String?
  lastDurationMs     Int?
  lastItemsProcessed Int                @default(0)
  lastItemsAdded     Int                @default(0)
  lastItemsChanged   Int                @default(0)
  lastErrorCount     Int                @default(0)
  last429Count       Int                @default(0)
  last5xxCount       Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([jobType])
  @@index([nextRunAt])
}

